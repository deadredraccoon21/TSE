          "format": "table",
          "rawQuery": true,
          "rawSql": "IF '$WvgL3' = 'WvgL3_RH' \r\nBEGIN \r\n    SELECT  \r\n        CONVERT(datetime, CONVERT(varchar, date, 23) + ' ' + CONVERT(varchar, time, 108)) AS date_and_time, \r\n        Set_RH,\r\n        Act_RH,\r\n        Pump_Output,\r\n        Pump_Status,\r\n        SAF_Speed,\r\n        RetAF_Speed\r\n    FROM  \r\n        tse_data.dbo.WvgL3_RH; \r\nEND \r\nELSE IF '$WvgL3' = 'WvgL3_T' \r\nBEGIN \r\n    SELECT  \r\n        CONVERT(datetime, CONVERT(varchar, date, 23) + ' ' + CONVERT(varchar, time, 108)) AS date_and_time, \r\n        Set_Temp,\r\n        Act_temp,\r\n        Act_SA_Temp,\r\n        Set_SA_Temp,\r\n        Damper_Output \r\n    FROM  \r\n        tse_data.dbo.WvgL3_T; \r\nEND;",
          "refId": "A",
