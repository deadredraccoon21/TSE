            "editorMode": "code",
            "format": "table",
            "rawQuery": true,
            "rawSql": "IF '$AutoC' = 'AutoC_RH' \r\nBEGIN \r\n    SELECT  \r\n        CONVERT(datetime, CONVERT(varchar, date, 23) + ' ' + CONVERT(varchar, time, 108)) AS date_and_time, \r\n        Set_RH,\r\n        Act_RH,\r\n        WTC_Output,\r\n        WP_Status,\r\n        SAF_Speed,\r\n        RetAF_Speed\r\n    FROM  \r\n        tse_data.dbo.AutoC_RH; \r\nEND \r\nELSE IF '$AutoC' = 'AutoC_T' \r\nBEGIN \r\n    SELECT  \r\n        CONVERT(datetime, CONVERT(varchar, date, 23) + ' ' + CONVERT(varchar, time, 108)) AS date_and_time, \r\n        Set_Temp,\r\n        Act_temp,\r\n        Act_WoT,\r\n        Set_WoT,\r\n        Damper_Output \r\n    FROM  \r\n        tse_data.dbo.AutoC_T; \r\nEND;",
            "refId": "A",
            "sql": {
