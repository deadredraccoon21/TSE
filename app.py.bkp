# ===============================================================================
# === HELPER: RUN POWERSHELL SCRIPT                                           ===
# ===============================================================================
def run_powershell(script_name, args):
    """
    Executes a PowerShell script and prints output to console.
    """
    try:
        script_path = os.path.join(BASE_DIR, "grafana_dashboards", script_name) 
        
        if not os.path.exists(script_path):
            print(f"ERROR: PowerShell script not found at {script_path}")
            return

        # Build command: powershell -ExecutionPolicy Bypass -File script.ps1 arg1 arg2 ...
        cmd = ["powershell.exe", "-ExecutionPolicy", "Bypass", "-File", script_path] + args
        
        print(f"--- Executing PowerShell: {script_name} ---")
        # capture_output=True captures stdout/stderr, text=True decodes bytes to strings
        result = subprocess.run(cmd, capture_output=True, text=True)
        
        if result.stdout:
            print("--- OUTPUT ---")
            print(result.stdout)
        
        if result.stderr:
            print("--- ERROR STREAM ---")
            print(result.stderr)
            
        print("--- End PowerShell Execution ---")
        
    except Exception as e:
        print(f"CRITICAL ERROR executing PowerShell: {e}")

# ===============================================================================
# === DB CONNECTION                                                           ===
# ===============================================================================
def create_connection():
    drivers = ['ODBC Driver 11 for SQL Server', 'ODBC Driver 17 for SQL Server']
    while True:
        for driver in drivers:
            try:
                conn_str = f'DRIVER={{{driver}}};SERVER={DB_SERVER};DATABASE={DB_DATABASE};UID={DB_USER};PWD={DB_PASSWORD}'
                print(f"Attempting connection with: {driver}")
                conn = pyodbc.connect(conn_str)
                print("Database connection successful.")
                return conn
            except pyodbc.Error as e:
                print(f"Connection with {driver} failed: {e}")
                continue
        print("All database drivers failed. Retrying in 5 seconds...")
        time.sleep(5)

def connect_to_db():
    return create_connection()

