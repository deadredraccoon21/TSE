def slugify(value):
    """
    Sanitizes a string to be used as a valid CSS selector/ID.
    """
    value = re.sub(r'[^\w\-]+', '_', value).strip('_')
    return value.lower()

app.jinja_env.filters['slugify'] = slugify 
